# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/KnowledgeAssistant.Worker/KnowledgeAssistant.Worker.csproj src/KnowledgeAssistant.Worker/
COPY src/KnowledgeAssistant.Infrastructure/KnowledgeAssistant.Infrastructure.csproj src/KnowledgeAssistant.Infrastructure/
RUN dotnet restore src/KnowledgeAssistant.Worker/KnowledgeAssistant.Worker.csproj

COPY src/ src/
RUN dotnet publish src/KnowledgeAssistant.Worker/KnowledgeAssistant.Worker.csproj \
    -c Release -o /app/publish --no-restore /p:UseAppHost=false

# The Worker serves no HTTP, so the plain .NET runtime image is enough (smaller than aspnet).
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
USER $APP_UID
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "KnowledgeAssistant.Worker.dll"]
